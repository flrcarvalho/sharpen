      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.betpix365.bet.br/*", "*://betpix365.bet.br/*"],
      "js": ["vb_inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.estrelabet.bet.br/*", "*://estrelabet.bet.br/*"],
      "js": ["vb_inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.betnacional.bet.br/*", "*://betnacional.bet.br/*"],
      "js": ["bnc_inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
