    },
    {
      "matches": ["*://*.1xbet.bet.br/*", "*://1xbet.bet.br/*"],
      "js": ["x1_inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.sportingbet.bet.br/*", "*://sportingbet.bet.br/*"],
      "js": ["spb_inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.lottu.bet.br/*", "*://lottu.bet.br/*"],
      "js": ["lt_inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.bolsadeaposta.bet.br/*"],
      "js": ["bda_inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.msjxk.com/*"],
      "js": ["bds_inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
