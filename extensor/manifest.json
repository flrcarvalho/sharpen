{
  "manifest_version": 3,
  "name": "SharpenUp",
  "version": "0.7.5",
  "description": "A perninha do Sharpen: captura seus bilhetes na casa e sobe pro painel do sharpen.bet via pareamento por código.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SharpenUp"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.superbet.bet.br/*", "*://superbet.bet.br/*", "*://*.superbet.com/*"],
      "js": ["sb_inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.betesporte.bet.br/*", "*://betesporte.bet.br/*"],
      "js": ["be_inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.betano.bet.br/*", "*://betano.bet.br/*"],
      "js": ["bn_inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.betfair.bet.br/*", "*://betfair.bet.br/*"],
      "js": ["bf_inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.pinnacle.bet.br/*", "*://pinnacle.bet.br/*"],
      "js": ["pn_inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.bet365.bet.br/*", "*://bet365.bet.br/*", "*://*.bet365.com/*", "*://bet365.com/*"],
      "js": ["b3_inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.bet365.bet.br/*", "*://bet365.bet.br/*", "*://*.bet365.com/*", "*://bet365.com/*"],
      "js": ["b3_expand.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://*.kto.bet.br/*", "*://kto.bet.br/*"],
      "js": ["kto_inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.stake.bet.br/*", "*://stake.bet.br/*"],
      "js": ["stk_inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.tivo.bet.br/*", "*://tivo.bet.br/*"],
      "js": ["tv_inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.betfast.bet.br/*", "*://betfast.bet.br/*"],
      "js": ["tv_inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.faz1.bet.br/*", "*://faz1.bet.br/*"],
      "js": ["tv_inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.vaidebet.bet.br/*", "*://vaidebet.bet.br/*"],
      "js": ["vb_inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
